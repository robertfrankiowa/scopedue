{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "ScopeDue",
  "version": "1.0.0",
  "key": "",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "app.html"
  },
  "permissions": [
    "identity",
    "alarms",
    "contextMenus",
    "activeTab",
    "storage",
    "sidePanel",
    "scripting"
  ],
  "externally_connectable": {
    "matches": ["https://scopedue.com/api/join.html*"]
  },
  "optional_permissions": [
    "tabs"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "side_panel": {
    "default_path": "capture.html"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "__MSG_cmdSave__"
    }
  }
}
